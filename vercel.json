{
  "buildCommand": "npm run build",
  "outputDirectory": "build",

  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googleapis.com https://*.firebaseio.com https://*.firebase.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebase.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com wss://*.firebaseio.com https://api.emailjs.com https://api.anthropic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://dentons-kmn.vercel.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    }
  ],

  "redirects": [
    { "source": "/wp-admin/:path*",      "destination": "/",     "permanent": false },
    { "source": "/wp-login.php",          "destination": "/",     "permanent": false },
    { "source": "/wp-config.php",         "destination": "/404",  "permanent": false },
    { "source": "/adminer.php",           "destination": "/404",  "permanent": false },
    { "source": "/adminer",               "destination": "/404",  "permanent": false },
    { "source": "/config.php",            "destination": "/404",  "permanent": false },
    { "source": "/configuration.php",     "destination": "/404",  "permanent": false },
    { "source": "/config.xml",            "destination": "/404",  "permanent": false },
    { "source": "/web.config",            "destination": "/404",  "permanent": false },
    { "source": "/backup.sql",            "destination": "/404",  "permanent": false },
    { "source": "/db_backup.sql",         "destination": "/404",  "permanent": false },
    { "source": "/dump.sql",              "destination": "/404",  "permanent": false },
    { "source": "/database.sql",          "destination": "/404",  "permanent": false },
    { "source": "/actuator/:path*",       "destination": "/404",  "permanent": false },
    { "source": "/debug",                 "destination": "/404",  "permanent": false },
    { "source": "/shell.php",             "destination": "/404",  "permanent": false },
    { "source": "/cmd.php",               "destination": "/404",  "permanent": false },
    { "source": "/webshell.php",          "destination": "/404",  "permanent": false },
    { "source": "/backdoor.php",          "destination": "/404",  "permanent": false },
    { "source": "/c99.php",               "destination": "/404",  "permanent": false },
    { "source": "/r57.php",               "destination": "/404",  "permanent": false },
    { "source": "/upload.php",            "destination": "/404",  "permanent": false },
    { "source": "/file_manager.php",      "destination": "/404",  "permanent": false },
    { "source": "/manager.php",           "destination": "/404",  "permanent": false },
    { "source": "/filemanager",           "destination": "/404",  "permanent": false },
    { "source": "/db.php",                "destination": "/404",  "permanent": false },
    { "source": "/database.php",          "destination": "/404",  "permanent": false },
    { "source": "/sql.php",               "destination": "/404",  "permanent": false },
    { "source": "/passwd",                "destination": "/404",  "permanent": false },
    { "source": "/shadow",                "destination": "/404",  "permanent": false },
    { "source": "/id_rsa",                "destination": "/404",  "permanent": false },
    { "source": "/id_dsa",                "destination": "/404",  "permanent": false },
    { "source": "/.bash_history",         "destination": "/404",  "permanent": false },
    { "source": "/.ssh/:path*",           "destination": "/404",  "permanent": false },
    { "source": "/.aws/:path*",           "destination": "/404",  "permanent": false },
    { "source": "/settings.php",          "destination": "/404",  "permanent": false },
    { "source": "/local.xml",             "destination": "/404",  "permanent": false },
    { "source": "/appsettings.json",      "destination": "/404",  "permanent": false },
    { "source": "/aws.json",              "destination": "/404",  "permanent": false },
    { "source": "/credentials",           "destination": "/404",  "permanent": false },
    { "source": "/google-services.json",  "destination": "/404",  "permanent": false },
    { "source": "/graphql",               "destination": "/404",  "permanent": false },
    { "source": "/graphiql",              "destination": "/404",  "permanent": false },
    { "source": "/_graphql",              "destination": "/404",  "permanent": false },
    { "source": "/console",               "destination": "/404",  "permanent": false },
    { "source": "/rails/info/properties", "destination": "/404",  "permanent": false },
    { "source": "/telescope",             "destination": "/404",  "permanent": false },
    { "source": "/horizon",               "destination": "/404",  "permanent": false },
    { "source": "/_profiler",             "destination": "/404",  "permanent": false },
    { "source": "/_wdt",                  "destination": "/404",  "permanent": false },
    { "source": "/trace",                 "destination": "/404",  "permanent": false },
    { "source": "/metrics",               "destination": "/404",  "permanent": false },
    { "source": "/health",                "destination": "/404",  "permanent": false },
    { "source": "/env",                   "destination": "/404",  "permanent": false }
  ]
}
